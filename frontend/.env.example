# Frontend environment variables.
#
# Every variable below is OPTIONAL — every one has a code-level
# default (see src/config/branding.ts and vite.config.ts), so the
# app runs correctly with none of these set. Copy this file to
# .env.local and override only what a specific deployment needs.
#
# No secrets belong in this file or in any VITE_* variable — Vite
# inlines every VITE_-prefixed variable into the client-side
# bundle at build time, so anything placed here is publicly
# visible in the shipped JavaScript.

# --- API connection ---

# Base path the frontend's Axios client prepends to every request.
# Default (if unset): /api/v1
VITE_API_BASE_URL=/api/v1

# The backend's own origin (scheme + host + port), used ONLY to
# build full URLs for public static assets like the company logo
# (served at /public-uploads/... on the backend, NOT under
# VITE_API_BASE_URL's /api/v1 prefix). Leave empty when frontend
# and backend share the same origin behind a reverse proxy — the
# resulting relative path just works. Set explicitly (e.g.
# https://api.example.com) when frontend and backend are deployed
# to different origins (e.g. Vercel + Railway).
VITE_API_ORIGIN=

# Dev-server-only: where Vite's dev proxy forwards /api requests.
# Read via process.env in vite.config.ts, not the browser bundle.
# Default (if unset): http://localhost:3000
VITE_API_PROXY_TARGET=http://localhost:3000

# --- Deployment-time branding (Phase 3A decision 6) ---
# Mizan is a SHARED multi-tenant product — VITE_BRAND_COMPANY_NAME/
# LOGO_URL below are NOT per-customer branding (each logged-in
# company's own name/logo is fetched live via useCompanyInfo(),
# see src/layouts/Sidebar.tsx). These env vars only control MIZAN's
# OWN identity shown before login (LoginPage, SignupPage, etc.) and
# the color palette used everywhere — see src/config/branding.ts.

# Default (if unset): "" (Sidebar shows nothing until the real
# company name loads — see branding.ts's comment on why this is
# deliberately blank, not a placeholder).
VITE_BRAND_COMPANY_NAME=""

# Default (if unset): /logo.svg — Mizan's own mark.
VITE_BRAND_LOGO_URL=/logo.svg

# Default (if unset): /favicon.svg
VITE_BRAND_FAVICON_URL=/favicon.svg

# RGB triplet, space-separated, no commas — matches Tailwind's
# rgb(var(--x) / <alpha-value>) convention (src/config/theme.ts).
# Default (if unset): 43 76 111 (Mizan's deep slate-blue)
VITE_BRAND_PRIMARY_RGB="43 76 111"

# Default (if unset): 201 162 75 (Mizan's warm gold)
VITE_BRAND_SECONDARY_RGB="201 162 75"

# One of: en, ar
# Default (if unset): ar
VITE_BRAND_DEFAULT_LANGUAGE=ar

# --- NOT CURRENTLY WIRED TO ANYTHING ---
# Declared in branding.ts's BrandingConfig for a planned
# quotation/invoice PDF header, but no consumer reads these yet
# (confirmed this session — grep for companyAddress/companyPhone/
# companyEmail/companyTaxNumber outside branding.ts returns
# nothing). Left here rather than silently dropped, but do not
# rely on setting these to actually affect any printed document
# today. If/when that PDF feature is built, it should very likely
# read the real tenant's own Company record from the backend
# instead of a single shared env-var value, the same fix already
# applied to companyName/logoUrl above.
VITE_BRAND_COMPANY_ADDRESS=""
VITE_BRAND_COMPANY_PHONE=""
VITE_BRAND_COMPANY_EMAIL=""
VITE_BRAND_COMPANY_TAX_NUMBER=""
