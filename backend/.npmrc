# Retry tuning — a real Docker build on an unstable connection hit
# ECONNRESET fetching @prisma/client mid-download, which aborted
# the whole `npm install` with no retry. npm DOES retry transient
# network errors by default, but with fairly short timeouts/delays
# that a slow or flaky connection can still exhaust. These make it
# more patient before giving up, without changing anything about
# what gets installed.
fetch-retries=5
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000
fetch-timeout=300000
