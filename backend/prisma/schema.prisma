  action    String
  createdAt DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]
  userPermissions UserPermission[]

  @@unique([module, resource, action])
  @@map("permissions")
}

model UserRole {
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  // Scope narrows this specific grant to one record of scopeType
  // rather than the whole company — e.g. scopeType 'department',
  // scopeId <a real departments.id> means this role only applies
  // to that department's own data.
  //
  // scopeId is NOT NULL with a fixed sentinel
  // ('00000000-0000-0000-0000-000000000000') meaning "unscoped —
  // applies company-wide", rather than actual NULL. This is
  // deliberate: Postgres primary/unique keys can't contain a
  // nullable column cleanly (multiple NULLs are treated as
  // distinct, which would silently allow duplicate "unscoped"
  // grants of the same role to slip in), and this project has no
  // real Prisma install available in this environment to verify
  // nullable-compound-unique-key `where` behavior empirically —
  // the sentinel sidesteps needing to trust that untested
  // behavior at all. COMPANY_WIDE_SCOPE_ID in roles.service.ts is
  // the single source of truth for this constant; nothing should
  // hardcode the literal string a second time.
  scopeType String  @default("company") @map("scope_type")
  scopeId   String  @default("00000000-0000-0000-0000-000000000000") @map("scope_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId, scopeId])
  @@map("user_roles")
}

model UserPermission {
  userId       String   @map("user_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  // Same scoping idea and same sentinel-over-NULL rationale as
  // UserRole.scopeType/scopeId — see its comment. Granting a
  // direct permission this way (a "permission set" style
  // exception) does not require creating or editing a role.
  scopeType    String   @default("company") @map("scope_type")
  scopeId      String   @default("00000000-0000-0000-0000-000000000000") @map("scope_id") @db.Uuid

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId, scopeId])
  @@map("user_permissions")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

