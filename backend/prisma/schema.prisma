// ============================================================
// Prisma schema — Company Management System V1
// Mirrors the approved 21 migration files exactly.
// No schema changes made in Phase 2 — this is a direct
// translation of 001-019 into Prisma models.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------
// MODULE 1 — ADMINISTRATION
// ------------------------------------------------------------

model Company {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  legalName  String?   @map("legal_name")
  email      String?
  phone      String?
  website    String?
  logo       String?
  address    String?
  city       String?
  country    String?
  taxNumber  String?   @map("tax_number")
  microsoftClientId String? @map("microsoft_client_id")
  microsoftClientSecretEncrypted String? @map("microsoft_client_secret_encrypted")
  status     String    @default("active") // active | inactive | suspended
  defaultWorkingDays Int[] @default([0, 1, 2, 3, 4]) @map("default_working_days")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  departments    Department[]
  users          User[]
  employees      Employee[]
  roles          Role[]
  customers      Customer[]
  customerUsers  CustomerUser[]
  leads          Lead[]
  opportunities  Opportunity[]
  quotations     Quotation[]
  projects       Project[]
  workOrders     WorkOrder[]
  tasks          Task[]
  comments       Comment[]
  activityLogs   ActivityLog[]
  notifications  Notification[]
  chartOfAccounts Account[]
  journalEntries  JournalEntry[]
  financeSettings FinanceSettings?
  invoices        Invoice[]
  payments        Payment[]
  vendors         Vendor[]
  bills           Bill[]
  billPayments    BillPayment[]
  accountingPeriods AccountingPeriod[]
  invoiceNotes InvoiceNote[]
  customerPayments CustomerPayment[]
  inventoryItems InventoryItem[]
  inventoryMovements InventoryMovement[]
  payrollSettings PayrollSettings?
  payrollRuns PayrollRun[]
  timeEntries TimeEntry[]
  interactions Interaction[]
  purchaseOrders PurchaseOrder[]
  fixedAssets FixedAsset[]
  depreciationRuns DepreciationRun[]
  attachments Attachment[]
  bankReconciliations BankReconciliation[]
  recurringInvoiceTemplates RecurringInvoiceTemplate[]
  vehicles Vehicle[]
  emailIntegrations EmailIntegration[]
  automationRules AutomationRule[]
  customFieldDefinitions CustomFieldDefinition[]
  leaveTypes LeaveType[]
  leaveBalances LeaveBalance[]
  leaveRequests LeaveRequest[]
  performanceCycles PerformanceCycle[]
  performanceCriteria PerformanceCriterion[]
  performanceEvaluations PerformanceEvaluation[]
  reportDefinitions ReportDefinition[]
  approvalWorkflows ApprovalWorkflow[]
  approvalRequests ApprovalRequest[]
  warehouses Warehouse[]
  stockItems StockItem[]
  inventoryStock InventoryStock[]
  stockMovements StockMovement[]
  zatcaCertificates ZatcaCertificate[]
  zatcaSubmissions ZatcaSubmission[]
  attachmentSignatures AttachmentSignature[]

  @@map("companies")
}

model Department {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  name        String
  description String?
  managerId   String?   @map("manager_id") @db.Uuid // -> employees.id
  status      String    @default("active") // active | inactive
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  company   Company    @relation(fields: [companyId], references: [id])
  manager   Employee?  @relation("DepartmentManager", fields: [managerId], references: [id])
  employees Employee[] @relation("EmployeeDepartment")

  @@map("departments")
}

model User {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId     String    @map("company_id") @db.Uuid
  name          String
  email         String    @unique
  passwordHash  String    @map("password_hash")
  phone         String?
  status        String    @default("active") // active | inactive | locked
  failedLoginAttempts Int @default(0) @map("failed_login_attempts")
  lastLoginAt   DateTime? @map("last_login_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  company       Company        @relation(fields: [companyId], references: [id])
  employee      Employee?      // 0..1, owned by Employee.userId
  userRoles     UserRole[]
  userPermissions UserPermission[]
  customerUsers CustomerUser[]
  ownedCustomers    Customer[]     @relation("CustomerOwner")
  ownedLeads        Lead[]         @relation("LeadOwner")
  convertedLeads    Lead[]         @relation("LeadConvertedBy")
  ownedOpportunities Opportunity[] @relation("OpportunityOwner")
  createdQuotations  Quotation[]   @relation("QuotationCreatedBy")
  createdProjects    Project[]     @relation("ProjectCreatedBy")
  createdWorkOrders  WorkOrder[]   @relation("WorkOrderCreatedBy")
  createdTasks       Task[]        @relation("TaskCreatedBy")
  comments           Comment[]
  activityLogs       ActivityLog[]
  notifications      Notification[]
  passwordResetTokens PasswordResetToken[]
  postedJournalEntries JournalEntry[]
  createdInvoices      Invoice[]
  createdPayments      Payment[]
  createdBills         Bill[]
  createdBillPayments  BillPayment[]
  lockedAccountingPeriods AccountingPeriod[]
  createdInvoiceNotes InvoiceNote[]
  createdCustomerPayments CustomerPayment[]
  createdTimeEntries TimeEntry[]
  loggedInteractions Interaction[]
  approvedPurchaseOrders PurchaseOrder[] @relation("PurchaseOrderApprovedBy")
  createdPurchaseOrders  PurchaseOrder[] @relation("PurchaseOrderCreatedBy")
  createdFixedAssets FixedAsset[]
  createdRecurringInvoiceTemplates RecurringInvoiceTemplate[]
  createdVehicles Vehicle[]
  createdVehicleAssignments VehicleAssignment[]
  createdVehicleMaintenanceRecords VehicleMaintenanceRecord[]
  createdTaskDependencies TaskDependency[]
  emailIntegration EmailIntegration?
  emailSyncedMessages EmailSyncedMessage[]
  createdAutomationRules AutomationRule[]
  createdCustomFieldDefinitions CustomFieldDefinition[]
  uploadedAttachments Attachment[]
  approvedLeaveRequests LeaveRequest[]
  performanceEvaluationsGiven PerformanceEvaluation[]
  createdReportDefinitions ReportDefinition[]
  requestedApprovals ApprovalRequest[] @relation("ApprovalRequestedBy")
  approvalActionsGiven ApprovalAction[] @relation("ApprovalActionedBy")
  performedInventoryMovements StockMovement[]
  attachmentSignatures AttachmentSignature[]
  createdBankReconciliations BankReconciliation[]

  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

// ============================================================
// Finance — Phase F1 foundation (Chart of Accounts + Journal
// Entries + Lines). See migration 027 for the full design
// rationale. Later Finance phases (invoicing, payments,
// financial statements, ZATCA e-invoicing) build on top of this
// without needing to change these three models.
// ============================================================

model Account {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId     String    @map("company_id") @db.Uuid
  code          String    @db.VarChar(20)
  name          String    @db.VarChar(200)
  type          String // asset | liability | equity | revenue | expense
  normalBalance String    @map("normal_balance") // debit | credit
  cashFlowCategory String? @map("cash_flow_category") // operating | investing | financing
  zakatCategory String? @map("zakat_category") // long_term_liability | fixed_asset | long_term_investment
  parentId      String?   @map("parent_id") @db.Uuid
  description   String?
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  company           Company            @relation(fields: [companyId], references: [id])
  parent            Account?           @relation("AccountHierarchy", fields: [parentId], references: [id])
  children          Account[]          @relation("AccountHierarchy")
  journalEntryLines JournalEntryLine[]
  bankReconciliations BankReconciliation[]

  @@unique([companyId, code])
  @@map("chart_of_accounts")
}

model JournalEntry {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  entryNumber String    @map("entry_number") @db.VarChar(50)
  entryDate   DateTime  @map("entry_date") @db.Date
  reference   String?   @db.VarChar(200)
  description String?
  status      String    @default("draft") // draft | posted | void
  createdBy   String?   @map("created_by") @db.Uuid
  postedAt    DateTime? @map("posted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  company Company            @relation(fields: [companyId], references: [id])
  creator User?              @relation(fields: [createdBy], references: [id])
  lines   JournalEntryLine[]
  invoice Invoice?
  payment Payment?
  bill    Bill?
  billPayment BillPayment?
  invoiceNote InvoiceNote?
  disposedFixedAsset FixedAsset?

  @@unique([companyId, entryNumber])
  @@map("journal_entries")
}

model JournalEntryLine {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  journalEntryId String  @map("journal_entry_id") @db.Uuid
  accountId      String  @map("account_id") @db.Uuid
  debit          Decimal @default(0) @db.Decimal(14, 2)
  credit         Decimal @default(0) @db.Decimal(14, 2)
  description    String?
  lineOrder      Int     @default(0) @map("line_order")

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account      Account      @relation(fields: [accountId], references: [id])
  bankStatementLine BankStatementLine?

  @@map("journal_entry_lines")
}

// ============================================================
// Finance — Phase F2 (Invoicing + Payments). Builds on F1's
// Chart of Accounts / Journal Entries. See migration 029 for the
// full design rationale, especially FinanceSettings' role in
// telling the system which accounts to auto-post issued invoices
// and recorded payments against.
// ============================================================

model Currency {
  code      String   @id @db.VarChar(3)
  name      String   @db.VarChar(50)
  symbol    String   @db.VarChar(5)
  isActive  Boolean  @default(true) @map("is_active")

  @@map("currencies")
}

model FinanceSettings {
  companyId                   String   @id @map("company_id") @db.Uuid
  defaultReceivableAccountId  String?  @map("default_receivable_account_id") @db.Uuid
  defaultRevenueAccountId     String?  @map("default_revenue_account_id") @db.Uuid
  defaultTaxPayableAccountId  String?  @map("default_tax_payable_account_id") @db.Uuid
  defaultCashAccountId        String?  @map("default_cash_account_id") @db.Uuid
  defaultPayableAccountId     String?  @map("default_payable_account_id") @db.Uuid
  defaultExpenseAccountId     String?  @map("default_expense_account_id") @db.Uuid
  defaultTaxRecoverableAccountId String? @map("default_tax_recoverable_account_id") @db.Uuid
  defaultAssetDisposalGainLossAccountId String? @map("default_asset_disposal_gain_loss_account_id") @db.Uuid
  defaultFxGainLossAccountId  String?  @map("default_fx_gain_loss_account_id") @db.Uuid
  sellerName                  String?  @map("seller_name") @db.VarChar(200)
  vatRegistrationNumber       String?  @map("vat_registration_number") @db.VarChar(15)
  sellerStreetName            String?  @map("seller_street_name") @db.VarChar(200)
  sellerBuildingNumber        String?  @map("seller_building_number") @db.VarChar(10)
  sellerDistrict              String?  @map("seller_district") @db.VarChar(100)
  sellerCity                  String?  @map("seller_city") @db.VarChar(100)
  sellerPostalCode            String?  @map("seller_postal_code") @db.VarChar(10)
  lastZatcaIcv                Int      @default(0) @map("last_zatca_icv")
  updatedAt                   DateTime @default(now()) @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id])

  @@map("finance_settings")
}

model Invoice {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId      String    @map("company_id") @db.Uuid
  customerId     String    @map("customer_id") @db.Uuid
  quotationId    String?   @unique @map("quotation_id") @db.Uuid
  invoiceNumber  String    @map("invoice_number") @db.VarChar(50)
  issueDate      DateTime  @map("issue_date") @db.Date
  issuedAt       DateTime? @map("issued_at")
  dueDate        DateTime? @map("due_date") @db.Date
  status         String    @default("draft") // draft | sent | partially_paid | paid | overdue | cancelled
  subtotal       Decimal   @default(0) @db.Decimal(14, 2)
  discount       Decimal   @default(0) @db.Decimal(14, 2)
  tax            Decimal   @default(0) @db.Decimal(14, 2)
  total          Decimal   @default(0) @db.Decimal(14, 2)
  amountPaid     Decimal   @default(0) @map("amount_paid") @db.Decimal(14, 2)
  currencyCode     String  @default("SAR") @map("currency_code") @db.VarChar(3)
  exchangeRateToBase Decimal @default(1) @map("exchange_rate_to_base") @db.Decimal(14, 6)
  recurringTemplateId String? @map("recurring_template_id") @db.Uuid
  notes          String?
  warehouseId    String?   @map("warehouse_id") @db.Uuid
  journalEntryId String?   @unique @map("journal_entry_id") @db.Uuid
  createdBy      String?   @map("created_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  company      Company        @relation(fields: [companyId], references: [id])
  customer     Customer       @relation(fields: [customerId], references: [id])
  quotation    Quotation?     @relation(fields: [quotationId], references: [id])
  recurringTemplate RecurringInvoiceTemplate? @relation(fields: [recurringTemplateId], references: [id])
  warehouse    Warehouse?     @relation(fields: [warehouseId], references: [id])
  journalEntry JournalEntry?  @relation(fields: [journalEntryId], references: [id])
  createdByUser User?         @relation(fields: [createdBy], references: [id])
  items        InvoiceItem[]
  payments     Payment[]
  noteEntries  InvoiceNote[]
  zatcaSubmissions ZatcaSubmission[]

  @@unique([companyId, invoiceNumber])
  @@map("invoices")
}

model InvoiceItem {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceId   String   @map("invoice_id") @db.Uuid
  description String
  quantity    Decimal  @db.Decimal(12, 2)
  unitPrice   Decimal  @map("unit_price") @db.Decimal(14, 2)
  discount    Decimal  @default(0) @db.Decimal(14, 2)
  tax         Decimal  @default(0) @db.Decimal(14, 2)
  total       Decimal  @db.Decimal(14, 2)
  inventoryItemId String? @map("inventory_item_id") @db.Uuid
  stockItemId String?  @map("stock_item_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem? @relation("InvoiceItemInventory", fields: [inventoryItemId], references: [id])
  stockItem     StockItem?     @relation(fields: [stockItemId], references: [id])

  @@map("invoice_items")
}

model Payment {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId      String    @map("company_id") @db.Uuid
  invoiceId      String    @map("invoice_id") @db.Uuid
  amount         Decimal   @db.Decimal(14, 2)
  exchangeRateToBase Decimal @default(1) @map("exchange_rate_to_base") @db.Decimal(14, 6)
  paymentDate    DateTime  @map("payment_date") @db.Date
  method         String // cash | bank_transfer | card | cheque | other
  reference      String?   @db.VarChar(200)
  journalEntryId String?   @unique @map("journal_entry_id") @db.Uuid
  customerPaymentId String? @map("customer_payment_id") @db.Uuid
  createdBy      String?   @map("created_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")
  deletedAt      DateTime? @map("deleted_at")

  company      Company       @relation(fields: [companyId], references: [id])
  invoice      Invoice       @relation(fields: [invoiceId], references: [id])
  journalEntry JournalEntry? @relation(fields: [journalEntryId], references: [id])
  createdByUser User?        @relation(fields: [createdBy], references: [id])
  customerPayment CustomerPayment? @relation(fields: [customerPaymentId], references: [id])

  @@map("payments")
}

// ============================================================
// Finance — Phase F4 (Expenses / Accounts Payable). The mirror
// image of F2's Invoicing+Payments — money going OUT to vendors
// instead of coming IN from customers. See migration 031 for the
// full design rationale, especially why bill_payments is a
// SEPARATE table from payments rather than a shared/generic one.
// ============================================================

model Vendor {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  vendorCode  String    @map("vendor_code") @db.VarChar(50)
  name        String    @db.VarChar(200)
  email       String?
  phone       String?
  address     String?
  city        String?
  country     String?
  status      String    @default("active") // active | inactive
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  company Company @relation(fields: [companyId], references: [id])
  bills   Bill[]
  purchaseOrders PurchaseOrder[]

  @@unique([companyId, vendorCode])
  @@map("vendors")
}

model Bill {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId       String    @map("company_id") @db.Uuid
  vendorId        String    @map("vendor_id") @db.Uuid
  billNumber      String    @map("bill_number") @db.VarChar(50)
  vendorReference String?   @map("vendor_reference") @db.VarChar(200)
  billDate        DateTime  @map("bill_date") @db.Date
  dueDate         DateTime? @map("due_date") @db.Date
  status          String    @default("draft") // draft | received | partially_paid | paid | overdue | cancelled
  subtotal        Decimal   @default(0) @db.Decimal(14, 2)
  discount        Decimal   @default(0) @db.Decimal(14, 2)
  tax             Decimal   @default(0) @db.Decimal(14, 2)
  total           Decimal   @default(0) @db.Decimal(14, 2)
  amountPaid      Decimal   @default(0) @map("amount_paid") @db.Decimal(14, 2)
  notes           String?
  journalEntryId  String?   @unique @map("journal_entry_id") @db.Uuid
  projectId       String?   @map("project_id") @db.Uuid
  createdBy       String?   @map("created_by") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  company      Company        @relation(fields: [companyId], references: [id])
  vendor       Vendor         @relation(fields: [vendorId], references: [id])
  journalEntry JournalEntry?  @relation(fields: [journalEntryId], references: [id])
  project      Project?       @relation(fields: [projectId], references: [id])
  createdByUser User?         @relation(fields: [createdBy], references: [id])
  items        BillItem[]
  payments     BillPayment[]
  purchaseOrder PurchaseOrder?

  @@unique([companyId, billNumber])
  @@map("bills")
}

model BillItem {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  billId      String   @map("bill_id") @db.Uuid
  description String
  quantity    Decimal  @db.Decimal(12, 2)
  unitPrice   Decimal  @map("unit_price") @db.Decimal(14, 2)
  discount    Decimal  @default(0) @db.Decimal(14, 2)
  tax         Decimal  @default(0) @db.Decimal(14, 2)
  total       Decimal  @db.Decimal(14, 2)
  inventoryItemId String? @map("inventory_item_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  bill Bill @relation(fields: [billId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem? @relation("BillItemInventory", fields: [inventoryItemId], references: [id])

  @@map("bill_items")
}

model BillPayment {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId      String    @map("company_id") @db.Uuid
  billId         String    @map("bill_id") @db.Uuid
  amount         Decimal   @db.Decimal(14, 2)
  paymentDate    DateTime  @map("payment_date") @db.Date
  method         String // cash | bank_transfer | card | cheque | other
  reference      String?   @db.VarChar(200)
  journalEntryId String?   @unique @map("journal_entry_id") @db.Uuid
  createdBy      String?   @map("created_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")
  deletedAt      DateTime? @map("deleted_at")

  company      Company       @relation(fields: [companyId], references: [id])
  bill         Bill          @relation(fields: [billId], references: [id])
  journalEntry JournalEntry? @relation(fields: [journalEntryId], references: [id])
  createdByUser User?        @relation(fields: [createdBy], references: [id])

  @@map("bill_payments")
}

// ============================================================
// Finance — Phase F6 (Period Locking). Once a period's status is
// 'locked', PeriodLockService.assertDateNotLocked() rejects any
// NEW journal entry dated inside it, from any code path (manual
// entry, invoice issue, bill receive, either payment type). See
// migration 034 for why this deliberately does not also include
// an automatic closing-entry mechanism.
// ============================================================

model AccountingPeriod {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  name      String    @db.VarChar(100)
  startDate DateTime  @map("start_date") @db.Date
  endDate   DateTime  @map("end_date") @db.Date
  status    String    @default("open") // open | locked
  lockedAt  DateTime? @map("locked_at")
  lockedBy  String?   @map("locked_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id])
  locker  User?   @relation(fields: [lockedBy], references: [id])

  @@map("accounting_periods")
}

model Employee {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId      String    @map("company_id") @db.Uuid
  departmentId   String?   @map("department_id") @db.Uuid
  userId         String?   @unique @map("user_id") @db.Uuid // sole FK expressing User<->Employee
  employeeNumber String    @map("employee_number")
  firstName      String    @map("first_name")
  lastName       String    @map("last_name")
  jobTitle       String?   @map("job_title")
  phone          String?
  email          String?
  hireDate       DateTime? @map("hire_date") @db.Date
  managerId      String?   @map("manager_id") @db.Uuid
  status         String    @default("active") // active | inactive | terminated
  basicSalary       Decimal? @map("basic_salary") @db.Decimal(14, 2)
  housingAllowance  Decimal  @default(0) @map("housing_allowance") @db.Decimal(14, 2)
  otherAllowances   Decimal  @default(0) @map("other_allowances") @db.Decimal(14, 2)
  gosiEmployeeRate  Decimal? @map("gosi_employee_rate") @db.Decimal(6, 3)
  gosiEmployerRate  Decimal? @map("gosi_employer_rate") @db.Decimal(6, 3)
  hourlyRate        Decimal? @map("hourly_rate") @db.Decimal(10, 2)
  nationality       String?
  iqamaNumber       String?   @map("iqama_number")
  iqamaExpiryDate   DateTime? @map("iqama_expiry_date") @db.Date
  workingDaysOverride Int[]   @default([]) @map("working_days_override")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  company           Company      @relation(fields: [companyId], references: [id])
  department        Department?  @relation("EmployeeDepartment", fields: [departmentId], references: [id])
  user              User?        @relation(fields: [userId], references: [id])
  manager           Employee?    @relation("EmployeeManager", fields: [managerId], references: [id])
  subordinates      Employee[]   @relation("EmployeeManager")
  managedDepartments Department[] @relation("DepartmentManager")
  projectMembers    ProjectMember[]
  managedProjects   Project[]    @relation("ProjectManager")
  assignedWorkOrders WorkOrder[] @relation("WorkOrderAssignee")
  assignedTasks     Task[]       @relation("TaskAssignee")
