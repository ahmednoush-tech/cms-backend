// ============================================================
// Finance — Phase F8 (Credit/Debit Notes against Invoices).
// See migration 037 for the full design rationale, especially
// why one table with a noteType discriminator was chosen over
// two separate tables.
// ============================================================

model InvoiceNote {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
