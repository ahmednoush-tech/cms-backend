  averageUnitCost    Decimal   @default(0) @map("average_unit_cost") @db.Decimal(14, 4)
  inventoryAccountId String?   @map("inventory_account_id") @db.Uuid
  cogsAccountId      String?   @map("cogs_account_id") @db.Uuid
  isActive           Boolean   @default(true) @map("is_active")
  createdBy          String?   @map("created_by") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  company   Company             @relation(fields: [companyId], references: [id])
  movements InventoryMovement[]
  invoiceItems InvoiceItem[] @relation("InvoiceItemInventory")
  billItems    BillItem[]    @relation("BillItemInventory")
  purchaseOrderItems PurchaseOrderItem[]

  @@unique([companyId, sku])
  @@map("inventory_items")
}

model InventoryMovement {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId       String   @map("company_id") @db.Uuid
  inventoryItemId String   @map("inventory_item_id") @db.Uuid
  type            String // opening | purchase | sale | adjustment_increase | adjustment_decrease
  quantity        Decimal  @db.Decimal(14, 3)
  unitCost        Decimal? @map("unit_cost") @db.Decimal(14, 4)
  quantityAfter   Decimal  @map("quantity_after") @db.Decimal(14, 3)
  averageCostAfter Decimal @map("average_cost_after") @db.Decimal(14, 4)
  journalEntryId  String?  @map("journal_entry_id") @db.Uuid
  referenceType   String?  @map("reference_type") @db.VarChar(20)
  referenceId     String?  @map("reference_id") @db.Uuid
  notes           String?
  createdBy       String?  @map("created_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  company       Company       @relation(fields: [companyId], references: [id])
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@map("inventory_movements")
}

// ============================================================
// Payroll. See migration 045 for the full design rationale,
// especially why GOSI rates are per-employee fields with no
// hardcoded default rather than a company-wide constant.
// ============================================================

model PayrollSettings {
  id                            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId                     String   @unique @map("company_id") @db.Uuid
  salaryExpenseAccountId        String?  @map("salary_expense_account_id") @db.Uuid
  gosiEmployerExpenseAccountId  String?  @map("gosi_employer_expense_account_id") @db.Uuid
  gosiPayableAccountId          String?  @map("gosi_payable_account_id") @db.Uuid
  netPayPayableAccountId        String?  @map("net_pay_payable_account_id") @db.Uuid
  updatedAt                     DateTime @default(now()) @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id])

  @@map("payroll_settings")
}

model PayrollRun {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId             String    @map("company_id") @db.Uuid
  month                 Int
  year                  Int
  status                String    @default("draft") // draft | processed | paid | cancelled
  totalGross            Decimal   @default(0) @map("total_gross") @db.Decimal(14, 2)
  totalGosiEmployee     Decimal   @default(0) @map("total_gosi_employee") @db.Decimal(14, 2)
  totalGosiEmployer     Decimal   @default(0) @map("total_gosi_employer") @db.Decimal(14, 2)
  totalNet              Decimal   @default(0) @map("total_net") @db.Decimal(14, 2)
  journalEntryId        String?   @unique @map("journal_entry_id") @db.Uuid
  paymentJournalEntryId String?   @unique @map("payment_journal_entry_id") @db.Uuid
  processedAt           DateTime? @map("processed_at")
  paidAt                DateTime? @map("paid_at")
  createdBy             String?   @map("created_by") @db.Uuid
  createdAt             DateTime  @default(now()) @map("created_at")

  company Company   @relation(fields: [companyId], references: [id])
  payslips Payslip[]

  @@unique([companyId, month, year])
  @@map("payroll_runs")
}

model Payslip {
  id                        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  payrollRunId              String   @map("payroll_run_id") @db.Uuid
  employeeId                String   @map("employee_id") @db.Uuid
  basicSalary               Decimal  @map("basic_salary") @db.Decimal(14, 2)
  housingAllowance          Decimal  @default(0) @map("housing_allowance") @db.Decimal(14, 2)
  otherAllowances           Decimal  @default(0) @map("other_allowances") @db.Decimal(14, 2)
  grossPay                  Decimal  @map("gross_pay") @db.Decimal(14, 2)
  gosiEmployeeRate          Decimal  @default(0) @map("gosi_employee_rate") @db.Decimal(6, 3)
  gosiEmployerRate          Decimal  @default(0) @map("gosi_employer_rate") @db.Decimal(6, 3)
  gosiEmployeeDeduction     Decimal  @default(0) @map("gosi_employee_deduction") @db.Decimal(14, 2)
  gosiEmployerContribution  Decimal  @default(0) @map("gosi_employer_contribution") @db.Decimal(14, 2)
  netPay                    Decimal  @map("net_pay") @db.Decimal(14, 2)
  createdAt                 DateTime @default(now()) @map("created_at")

  payrollRun PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee   Employee   @relation(fields: [employeeId], references: [id])

  @@unique([payrollRunId, employeeId])
  @@map("payslips")
}

// ============================================================
// Operations — Time Tracking. See migration 047 for the full
// design rationale, especially why hourlyRateSnapshot is frozen
// at creation and why this is ordinary CRUD rather than the
// immutable-once-posted pattern financial documents use.
// ============================================================

model TimeEntry {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId           String    @map("company_id") @db.Uuid
  taskId              String    @map("task_id") @db.Uuid
  employeeId          String    @map("employee_id") @db.Uuid
  entryDate           DateTime  @map("entry_date") @db.Date
  hours               Decimal   @db.Decimal(6, 2)
  hourlyRateSnapshot  Decimal?  @map("hourly_rate_snapshot") @db.Decimal(10, 2)
  laborCost           Decimal?  @map("labor_cost") @db.Decimal(12, 2)
  notes               String?
  billable            Boolean   @default(true)
  createdBy           String?   @map("created_by") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt           DateTime? @map("deleted_at")

  company       Company  @relation(fields: [companyId], references: [id])
  task          Task     @relation(fields: [taskId], references: [id])
  employee      Employee @relation(fields: [employeeId], references: [id])
  createdByUser User?    @relation(fields: [createdBy], references: [id])

  @@map("time_entries")
}

// ============================================================
// CRM — Customer Interaction Log. See migration 049 for the full
// design rationale, especially why all three FKs are nullable but
// at least one is required (enforced by a DB CHECK constraint,
// not just application logic).
// ============================================================

model Interaction {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId       String    @map("company_id") @db.Uuid
  customerId      String?   @map("customer_id") @db.Uuid
  leadId          String?   @map("lead_id") @db.Uuid
  opportunityId   String?   @map("opportunity_id") @db.Uuid
  type            String // call | meeting | email | note | other
  subject         String    @db.VarChar(200)
  notes           String?
  interactionDate DateTime  @map("interaction_date")
  outcome         String?   @db.VarChar(200)
  followUpDate    DateTime? @map("follow_up_date") @db.Date
  createdBy       String?   @map("created_by") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  company       Company      @relation(fields: [companyId], references: [id])
  customer      Customer?    @relation(fields: [customerId], references: [id])
  lead          Lead?        @relation(fields: [leadId], references: [id])
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id])
  createdByUser User?        @relation(fields: [createdBy], references: [id])
  syncedFromEmail EmailSyncedMessage?

  @@map("interactions")
}

// ============================================================
// Finance — Purchase Orders with an approval workflow. See
// migration 053 for the full design rationale, especially why
// this posts NO journal entry (a PO is a commitment, not yet a
// liability) and why approval here is single-level, not a
// multi-step chain.
// ============================================================

model PurchaseOrder {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId             String    @map("company_id") @db.Uuid
  vendorId              String    @map("vendor_id") @db.Uuid
  poNumber              String    @map("po_number") @db.VarChar(50)
  status                String    @default("draft") // draft|pending_approval|approved|rejected|sent|closed|cancelled
  expectedDeliveryDate  DateTime? @map("expected_delivery_date") @db.Date
  notes                 String?
  rejectionReason       String?   @map("rejection_reason")
  subtotal              Decimal   @default(0) @db.Decimal(14, 2)
  discount              Decimal   @default(0) @db.Decimal(14, 2)
  tax                   Decimal   @default(0) @db.Decimal(14, 2)
  total                 Decimal   @default(0) @db.Decimal(14, 2)
  billId                String?   @unique @map("bill_id") @db.Uuid
  submittedAt           DateTime? @map("submitted_at")
  approvedBy            String?   @map("approved_by") @db.Uuid
  approvedAt            DateTime? @map("approved_at")
  sentAt                DateTime? @map("sent_at")
  createdBy             String?   @map("created_by") @db.Uuid
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt             DateTime? @map("deleted_at")

  company        Company             @relation(fields: [companyId], references: [id])
  vendor         Vendor              @relation(fields: [vendorId], references: [id])
  bill           Bill?               @relation(fields: [billId], references: [id])
  approvedByUser User?               @relation("PurchaseOrderApprovedBy", fields: [approvedBy], references: [id])
  createdByUser  User?               @relation("PurchaseOrderCreatedBy", fields: [createdBy], references: [id])
  items          PurchaseOrderItem[]

  @@unique([companyId, poNumber])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  purchaseOrderId String   @map("purchase_order_id") @db.Uuid
  description     String
  quantity        Decimal  @default(1) @db.Decimal(12, 2)
  unitPrice       Decimal  @default(0) @map("unit_price") @db.Decimal(14, 2)
  discount        Decimal  @default(0) @db.Decimal(14, 2)
  tax             Decimal  @default(0) @db.Decimal(14, 2)
  total           Decimal  @default(0) @db.Decimal(14, 2)
  inventoryItemId String?  @map("inventory_item_id") @db.Uuid
  stockItemId     String?  @map("stock_item_id") @db.Uuid
  receivedQuantity Decimal @default(0) @map("received_quantity") @db.Decimal(12, 2)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  purchaseOrder PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem? @relation(fields: [inventoryItemId], references: [id])
  stockItem     StockItem?     @relation(fields: [stockItemId], references: [id])

  @@map("purchase_order_items")
}

// ============================================================
// Finance — Fixed Assets & Depreciation. See migration 055 for
// the full design rationale, especially why straight-line is the
// only method built and why disposal accounting (gain/loss) is
// deliberately not included here.
// ============================================================

model FixedAsset {
  id                                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId                          String    @map("company_id") @db.Uuid
  assetNumber                        String    @map("asset_number") @db.VarChar(50)
  name                               String    @db.VarChar(200)
  category                           String?   @db.VarChar(100)
  description                        String?
  purchaseDate                       DateTime  @map("purchase_date") @db.Date
  purchaseCost                       Decimal   @map("purchase_cost") @db.Decimal(14, 2)
  salvageValue                       Decimal   @default(0) @map("salvage_value") @db.Decimal(14, 2)
  usefulLifeMonths                   Int       @map("useful_life_months")
  accumulatedDepreciation            Decimal   @default(0) @map("accumulated_depreciation") @db.Decimal(14, 2)
  fixedAssetAccountId                String?   @map("fixed_asset_account_id") @db.Uuid
  accumulatedDepreciationAccountId   String?   @map("accumulated_depreciation_account_id") @db.Uuid
  depreciationExpenseAccountId       String?   @map("depreciation_expense_account_id") @db.Uuid
  status                             String    @default("active") // active | fully_depreciated | disposed
  disposedAt                         DateTime? @map("disposed_at")
  disposalProceeds                   Decimal?  @map("disposal_proceeds") @db.Decimal(14, 2)
  disposalJournalEntryId             String?   @unique @map("disposal_journal_entry_id") @db.Uuid
  createdBy                          String?   @map("created_by") @db.Uuid
  createdAt                          DateTime  @default(now()) @map("created_at")
  updatedAt                          DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt                          DateTime? @map("deleted_at")

  company             Company              @relation(fields: [companyId], references: [id])
  createdByUser       User?                @relation(fields: [createdBy], references: [id])
  disposalJournalEntry JournalEntry?       @relation(fields: [disposalJournalEntryId], references: [id])
  depreciationEntries DepreciationEntry[]

  @@unique([companyId, assetNumber])
  @@map("fixed_assets")
}

model DepreciationRun {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId         String   @map("company_id") @db.Uuid
  month             Int
  year              Int
  totalDepreciation Decimal  @default(0) @map("total_depreciation") @db.Decimal(14, 2)
  journalEntryId    String?  @unique @map("journal_entry_id") @db.Uuid
  createdBy         String?  @map("created_by") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")

  company  Company              @relation(fields: [companyId], references: [id])
  entries  DepreciationEntry[]

  @@unique([companyId, month, year])
  @@map("depreciation_runs")
}

model DepreciationEntry {
  id                            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  depreciationRunId             String   @map("depreciation_run_id") @db.Uuid
  fixedAssetId                  String   @map("fixed_asset_id") @db.Uuid
  depreciationAmount            Decimal  @map("depreciation_amount") @db.Decimal(14, 2)
  accumulatedDepreciationAfter  Decimal  @map("accumulated_depreciation_after") @db.Decimal(14, 2)
  netBookValueAfter             Decimal  @map("net_book_value_after") @db.Decimal(14, 2)
  createdAt                     DateTime @default(now()) @map("created_at")

  depreciationRun DepreciationRun @relation(fields: [depreciationRunId], references: [id], onDelete: Cascade)
  fixedAsset      FixedAsset      @relation(fields: [fixedAssetId], references: [id])

  @@unique([depreciationRunId, fixedAssetId])
  @@map("depreciation_entries")
}

// ============================================================
// Attachments — polymorphic file uploads across every attachable
// entity type. See migration 057 for the full design rationale,
// especially the LOCAL DISK storage decision and why entity_type
// is a closed, validated list rather than an open string.
// ============================================================

model Attachment {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  entityType     String   @map("entity_type") @db.VarChar(30)
  entityId       String   @map("entity_id") @db.Uuid
  fileName       String   @map("file_name") @db.VarChar(255)
  storedFileName String   @map("stored_file_name") @db.VarChar(255)
  mimeType       String   @map("mime_type") @db.VarChar(100)
  fileSizeBytes  Int      @map("file_size_bytes")
  uploadedBy     String?  @map("uploaded_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  documentGroupId   String  @map("document_group_id") @db.Uuid
  versionNumber     Int     @default(1) @map("version_number")
  isCurrentVersion  Boolean @default(true) @map("is_current_version")

  company        Company @relation(fields: [companyId], references: [id])
  uploadedByUser User?   @relation(fields: [uploadedBy], references: [id])
  documentGroup  Attachment?  @relation("DocumentVersions", fields: [documentGroupId], references: [id])
  versions       Attachment[] @relation("DocumentVersions")
  signatures     AttachmentSignature[]

  @@map("attachments")
}

// NOT a legally-binding e-signature system — see migration 105's
// comment for the full disclosure. An audit record that a
// specific user acknowledged/signed a SPECIFIC attachment VERSION
// (never the document group as a whole — see that same comment
// for why).
model AttachmentSignature {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  attachmentId   String   @map("attachment_id") @db.Uuid
  signedBy       String   @map("signed_by") @db.Uuid
  signatureType  String   @map("signature_type") // typed | drawn
  signatureData  String   @map("signature_data")
  ipAddress      String?  @map("ip_address")
  signedAt       DateTime @default(now()) @map("signed_at")

  company      Company    @relation(fields: [companyId], references: [id])
  attachment   Attachment @relation(fields: [attachmentId], references: [id])
  signedByUser User       @relation(fields: [signedBy], references: [id])

  @@map("attachment_signatures")
}

// ============================================================
// Bank Reconciliation. See migration 059 for the full design
// rationale, especially the two-sided adjustment formula used at
// completion and why a non-zero variance has no override.
// ============================================================

model BankReconciliation {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId              String    @map("company_id") @db.Uuid
  bankAccountId          String    @map("bank_account_id") @db.Uuid
  statementDate          DateTime  @map("statement_date") @db.Date
  statementEndingBalance Decimal   @map("statement_ending_balance") @db.Decimal(14, 2)
  bookBalance            Decimal?  @map("book_balance") @db.Decimal(14, 2)
  status                 String    @default("in_progress") // in_progress | completed
  completedAt            DateTime? @map("completed_at")
  createdBy              String?   @map("created_by") @db.Uuid
  createdAt              DateTime  @default(now()) @map("created_at")

  company     Company              @relation(fields: [companyId], references: [id])
  bankAccount Account              @relation(fields: [bankAccountId], references: [id])
  createdByUser User?              @relation(fields: [createdBy], references: [id])
  statementLines BankStatementLine[]

  @@unique([companyId, bankAccountId, statementDate])
  @@map("bank_reconciliations")
}

model BankStatementLine {
  id                        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bankReconciliationId      String   @map("bank_reconciliation_id") @db.Uuid
  transactionDate           DateTime @map("transaction_date") @db.Date
  description               String
  amount                    Decimal  @db.Decimal(14, 2)
  matchedJournalEntryLineId String?  @unique @map("matched_journal_entry_line_id") @db.Uuid
  createdAt                 DateTime @default(now()) @map("created_at")

  bankReconciliation     BankReconciliation @relation(fields: [bankReconciliationId], references: [id], onDelete: Cascade)
  matchedJournalEntryLine JournalEntryLine? @relation(fields: [matchedJournalEntryLineId], references: [id])

  @@map("bank_statement_lines")
}

// ============================================================
// Recurring Invoice Templates — see migration 065 for the full
// design rationale, especially why generation is an explicit
// on-demand action, not a real cron job.
// ============================================================

model RecurringInvoiceTemplate {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId           String    @map("company_id") @db.Uuid
  customerId          String    @map("customer_id") @db.Uuid
  name                String    @db.VarChar(200)
  currencyCode        String    @default("SAR") @map("currency_code") @db.VarChar(3)
  exchangeRateToBase  Decimal   @default(1) @map("exchange_rate_to_base") @db.Decimal(14, 6)
  frequency           String // monthly | quarterly | yearly
  startDate           DateTime  @map("start_date") @db.Date
  nextGenerationDate  DateTime  @map("next_generation_date") @db.Date
  endDate             DateTime? @map("end_date") @db.Date
  status              String    @default("active") // active | paused | completed | cancelled
  notes               String?
  createdBy           String?   @map("created_by") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at")

  company        Company                        @relation(fields: [companyId], references: [id])
  customer       Customer                       @relation(fields: [customerId], references: [id])
  createdByUser  User?                          @relation(fields: [createdBy], references: [id])
  items          RecurringInvoiceTemplateItem[]
  generatedInvoices Invoice[]

  @@map("recurring_invoice_templates")
}

model RecurringInvoiceTemplateItem {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  templateId  String  @map("template_id") @db.Uuid
  description String
  quantity    Decimal @db.Decimal(14, 2)
  unitPrice   Decimal @map("unit_price") @db.Decimal(14, 2)
  discount    Decimal @default(0) @db.Decimal(14, 2)
  tax         Decimal @default(0) @db.Decimal(14, 2)

  template RecurringInvoiceTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@map("recurring_invoice_template_items")
}

// ============================================================
// Fleet Management — see migration 068 for the full design
// rationale, especially why this is administrative record-keeping
// (who has which vehicle, its service history) and NOT real-time
// GPS tracking.
// ============================================================

model Vehicle {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId               String    @map("company_id") @db.Uuid
  plateNumber             String    @map("plate_number") @db.VarChar(20)
  make                    String    @db.VarChar(50)
  model                   String    @db.VarChar(50)
  year                    Int?
  vin                     String?   @db.VarChar(50)
  status                  String    @default("active") // active | maintenance | retired
  odometerReading         Int       @default(0) @map("odometer_reading")
  registrationExpiryDate  DateTime? @map("registration_expiry_date") @db.Date
  insuranceExpiryDate     DateTime? @map("insurance_expiry_date") @db.Date
  notes                   String?
  createdBy               String?   @map("created_by") @db.Uuid
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @default(now()) @updatedAt @map("updated_at")

  company         Company                  @relation(fields: [companyId], references: [id])
  createdByUser   User?                    @relation(fields: [createdBy], references: [id])
  assignments     VehicleAssignment[]
  maintenanceRecords VehicleMaintenanceRecord[]

  @@unique([companyId, plateNumber])
  @@map("vehicles")
}

model VehicleAssignment {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vehicleId    String    @map("vehicle_id") @db.Uuid
  employeeId   String    @map("employee_id") @db.Uuid
  assignedDate DateTime  @map("assigned_date") @db.Date
  returnedDate DateTime? @map("returned_date") @db.Date
  notes        String?
  createdBy    String?   @map("created_by") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")

  vehicle       Vehicle  @relation(fields: [vehicleId], references: [id])
  employee      Employee @relation(fields: [employeeId], references: [id])
  createdByUser User?    @relation(fields: [createdBy], references: [id])

  @@map("vehicle_assignments")
}

model VehicleMaintenanceRecord {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vehicleId         String   @map("vehicle_id") @db.Uuid
  serviceDate       DateTime @map("service_date") @db.Date
  serviceType       String   @map("service_type") @db.VarChar(100)
  description       String?
  cost              Decimal  @default(0) @db.Decimal(14, 2)
  odometerAtService Int      @map("odometer_at_service")
  performedBy       String?  @map("performed_by") @db.VarChar(200)
  createdBy         String?  @map("created_by") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")

  vehicle       Vehicle @relation(fields: [vehicleId], references: [id])
  createdByUser User?   @relation(fields: [createdBy], references: [id])

  @@map("vehicle_maintenance_records")
}

// ============================================================
// Task Dependencies — see migration 071 for the full design
// rationale (finish-to-start only, circular dependencies
// prevented at the application layer, not by the database).
// ============================================================

model TaskDependency {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId          String   @map("task_id") @db.Uuid
  dependsOnTaskId String   @map("depends_on_task_id") @db.Uuid
  createdBy       String?  @map("created_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  task          Task  @relation("TaskDependencies", fields: [taskId], references: [id])
  dependsOn     Task  @relation("TaskDependents", fields: [dependsOnTaskId], references: [id])
  createdByUser User? @relation(fields: [createdBy], references: [id])

  @@unique([taskId, dependsOnTaskId])
  @@map("task_dependencies")
}

// ============================================================
// Outlook Email Integration — see migration 073 for the full
// design rationale (per-user connection, Outlook/Microsoft Graph
// only, read-only, on-demand sync).
// ============================================================

model EmailIntegration {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId      String    @map("company_id") @db.Uuid
  userId         String    @unique @map("user_id") @db.Uuid
  provider       String    @default("outlook")
  connectedEmail String    @map("connected_email")
  accessToken    String    @map("access_token")
  refreshToken   String    @map("refresh_token")
  tokenExpiresAt DateTime  @map("token_expires_at")
  status         String    @default("active") // active | disconnected
  connectedAt    DateTime  @default(now()) @map("connected_at")
  lastSyncedAt   DateTime? @map("last_synced_at")

  company Company @relation(fields: [companyId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@map("email_integrations")
}

model EmailSyncedMessage {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  providerMessageId String   @map("provider_message_id") @db.VarChar(300)
  interactionId     String?  @unique @map("interaction_id") @db.Uuid
  syncedAt          DateTime @default(now()) @map("synced_at")

  user        User         @relation(fields: [userId], references: [id])
  interaction Interaction? @relation(fields: [interactionId], references: [id])

  @@unique([userId, providerMessageId])
  @@map("email_synced_messages")
}

// ============================================================
// CRM Workflow Automation — see migration 076 for the full
// design rationale (notification-only actions, synchronous
// in-process execution, no event bus).
// ============================================================

model AutomationRule {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId           String    @map("company_id") @db.Uuid
  name                String    @db.VarChar(200)
  isActive            Boolean   @default(true) @map("is_active")
  triggerEntityType   String    @map("trigger_entity_type") // lead | opportunity
  triggerEvent        String    @map("trigger_event") // created | stage_changed
  triggerToStage      String?   @map("trigger_to_stage") @db.VarChar(50)
  notificationTitle   String    @map("notification_title") @db.VarChar(200)
  notificationMessage String?   @map("notification_message")
  createdBy           String?   @map("created_by") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at")

  company       Company @relation(fields: [companyId], references: [id])
  createdByUser User?   @relation(fields: [createdBy], references: [id])

  @@map("automation_rules")
}

// ============================================================
// Custom Fields — see migration 078 for the full design
// rationale (LEADS ONLY for this version; values stored as JSONB
// on the entity, not a separate EAV table).
// ============================================================

model CustomFieldDefinition {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId     String   @map("company_id") @db.Uuid
  entityType    String   @map("entity_type") // lead (only value supported today)
  fieldKey      String   @map("field_key") @db.VarChar(50)
  label         String   @db.VarChar(200)
  fieldType     String   @map("field_type") // text | number | date | select
  selectOptions Json?    @map("select_options")
  isRequired    Boolean  @default(false) @map("is_required")
  isActive      Boolean  @default(true) @map("is_active")
  displayOrder  Int      @default(0) @map("display_order")
  createdBy     String?  @map("created_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  company       Company @relation(fields: [companyId], references: [id])
  createdByUser User?   @relation(fields: [createdBy], references: [id])

  @@unique([companyId, entityType, fieldKey])
  @@map("custom_field_definitions")
}

// ============================================================
// Platform Admin — Mizan's own operations team. Deliberately has
// NO relation to Company/User and NO companyId — see migration
// 080 for the full isolation rationale. Never confuse this with
// User (a tenant's own staff account).
// ============================================================

model PlatformAdmin {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String    @db.VarChar(200)
  email        String    @unique @db.VarChar(255)
  passwordHash String    @map("password_hash")
  status       String    @default("active") // active | disabled
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")

  @@map("platform_admins")
}

// ============================================================
// Platform Settings — a true singleton row (see migration 081)
// holding Mizan's own editable product identity. No relation to
// Company/User — same isolation rationale as PlatformAdmin.
// ============================================================

model PlatformSettings {
  id              String   @id @db.Uuid
  productName     String   @map("product_name") @db.VarChar(100)
  productTagline  String?  @map("product_tagline") @db.VarChar(200)
  logoUrl         String?  @map("logo_url") @db.VarChar(500)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("platform_settings")
}

// Platform-wide, singleton — see migration 093's comment for why
// this is deliberately NOT a per-company setting. The secret key
// is stored encrypted; PlatformStorageSettingsService never
// returns it in plaintext via any API response.
model PlatformStorageSettings {
  id                          String   @id @db.Uuid
  storageDriver               String   @default("local") @map("storage_driver") // local | s3
  s3Region                    String?  @map("s3_region") @db.VarChar(50)
  s3Bucket                    String?  @map("s3_bucket") @db.VarChar(255)
  s3AccessKeyId                String?  @map("s3_access_key_id") @db.VarChar(255)
  s3SecretAccessKeyEncrypted   String?  @map("s3_secret_access_key_encrypted")
  s3Endpoint                   String?  @map("s3_endpoint") @db.VarChar(500)
  s3ForcePathStyle             Boolean  @default(false) @map("s3_force_path_style")
  updatedAt                    DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("platform_storage_settings")
}

// ============================================================
// Leave Management — see migration 084 for the full design
// rationale (balance-tracked vs non-balance types, deduction only
// on approval, Sun-Thu working-week day counting).
// ============================================================

model LeaveType {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId       String    @map("company_id") @db.Uuid
  name            String    @db.VarChar(100)
  requiresBalance Boolean   @default(true) @map("requires_balance")
  isPaid          Boolean   @default(true) @map("is_paid")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  company  Company        @relation(fields: [companyId], references: [id])
  balances LeaveBalance[]
  requests LeaveRequest[]

  @@unique([companyId, name])
  @@map("leave_types")
}

model LeaveBalance {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId     String   @map("company_id") @db.Uuid
  employeeId    String   @map("employee_id") @db.Uuid
  leaveTypeId   String   @map("leave_type_id") @db.Uuid
  year          Int
  allocatedDays Decimal  @map("allocated_days") @db.Decimal(6, 2)
  usedDays      Decimal  @default(0) @map("used_days") @db.Decimal(6, 2)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  company   Company   @relation(fields: [companyId], references: [id])
  employee  Employee  @relation(fields: [employeeId], references: [id])
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@unique([employeeId, leaveTypeId, year])
  @@map("leave_balances")
}

model LeaveRequest {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId       String    @map("company_id") @db.Uuid
  employeeId      String    @map("employee_id") @db.Uuid
  leaveTypeId     String    @map("leave_type_id") @db.Uuid
  startDate       DateTime  @map("start_date") @db.Date
  endDate         DateTime  @map("end_date") @db.Date
  daysRequested   Decimal   @map("days_requested") @db.Decimal(6, 2)
  reason          String?
  status          String    @default("pending") // pending|approved|rejected|cancelled
  approvedBy      String?   @map("approved_by") @db.Uuid
  approvedAt      DateTime? @map("approved_at")
  rejectionReason String?   @map("rejection_reason")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")

  company        Company   @relation(fields: [companyId], references: [id])
  employee       Employee  @relation(fields: [employeeId], references: [id])
  leaveType      LeaveType @relation(fields: [leaveTypeId], references: [id])
  approvedByUser User?     @relation(fields: [approvedBy], references: [id])

  @@map("leave_requests")
}

// ============================================================
// Performance Evaluation — see migration 087 for the full design
// rationale (unweighted snapshot rating, no employee self-service
// acknowledgment step, subquery-based RLS on the child scores
// table).
// ============================================================

model PerformanceCycle {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  name       String   @db.VarChar(150)
  startDate  DateTime @map("start_date") @db.Date
  endDate    DateTime @map("end_date") @db.Date
  status     String   @default("open") // open | closed
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  company     Company                @relation(fields: [companyId], references: [id])
  evaluations PerformanceEvaluation[]

  @@map("performance_cycles")
}

model PerformanceCriterion {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  name        String    @db.VarChar(150)
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  company Company                       @relation(fields: [companyId], references: [id])
  scores  PerformanceEvaluationScore[]

  @@unique([companyId, name])
  @@map("performance_criteria")
}

model PerformanceEvaluation {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId       String    @map("company_id") @db.Uuid
  cycleId         String    @map("cycle_id") @db.Uuid
  employeeId      String    @map("employee_id") @db.Uuid
  evaluatorId     String    @map("evaluator_id") @db.Uuid
  overallComments String?   @map("overall_comments")
  overallRating   Decimal?  @map("overall_rating") @db.Decimal(3, 2)
  status          String    @default("draft") // draft | finalized
  finalizedAt     DateTime? @map("finalized_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")

  company   Company                      @relation(fields: [companyId], references: [id])
  cycle     PerformanceCycle             @relation(fields: [cycleId], references: [id])
  employee  Employee                     @relation(fields: [employeeId], references: [id])
  evaluator User                         @relation(fields: [evaluatorId], references: [id])
  scores    PerformanceEvaluationScore[]

  @@unique([cycleId, employeeId])
  @@map("performance_evaluations")
}

model PerformanceEvaluationScore {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  evaluationId String  @map("evaluation_id") @db.Uuid
  criterionId  String  @map("criterion_id") @db.Uuid
  score        Int
  comments     String?

  evaluation PerformanceEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  criterion  PerformanceCriterion  @relation(fields: [criterionId], references: [id])

  @@unique([evaluationId, criterionId])
  @@map("performance_evaluation_scores")
}

// ============================================================
// Custom Reports Engine — see migration 089's comment for the
// full "safe by design" rationale: entityType/groupByField/
// aggregateField/filters are validated against a fixed backend
// registry (reports-registry.ts) before ever building a query,
// never used as raw identifiers.
// ============================================================

model ReportDefinition {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId      String    @map("company_id") @db.Uuid
  name           String    @db.VarChar(150)
  entityType     String    @map("entity_type") @db.VarChar(50)
  groupByField   String    @map("group_by_field") @db.VarChar(50)
  aggregateType  String    @map("aggregate_type") // count | sum
  aggregateField String?   @map("aggregate_field") @db.VarChar(50)
  chartType      String    @default("bar") @map("chart_type") // bar | line | table
  filters        Json      @default("[]")
  createdBy      String?   @map("created_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  company       Company @relation(fields: [companyId], references: [id])
  createdByUser User?   @relation(fields: [createdBy], references: [id])

  @@map("report_definitions")
}

// ============================================================
// Generic Approval Workflow Engine — see migration 091's comment
// for the full "pure tracking, never execution" safety rationale.
// ============================================================

model ApprovalWorkflow {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  name      String   @db.VarChar(150)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  company  Company                @relation(fields: [companyId], references: [id])
  steps    ApprovalWorkflowStep[]
  requests ApprovalRequest[]

  @@unique([companyId, name])
  @@map("approval_workflows")
}

model ApprovalWorkflowStep {
  id              String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workflowId      String @map("workflow_id") @db.Uuid
  stepOrder       Int    @map("step_order")
  approverRoleId  String @map("approver_role_id") @db.Uuid

  workflow     ApprovalWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  approverRole Role             @relation(fields: [approverRoleId], references: [id])

  @@unique([workflowId, stepOrder])
  @@map("approval_workflow_steps")
}

model ApprovalRequest {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId         String   @map("company_id") @db.Uuid
  workflowId        String   @map("workflow_id") @db.Uuid
  title             String   @db.VarChar(200)
  description       String?
  amount            Decimal? @db.Decimal(14, 2)
  requestedBy       String   @map("requested_by") @db.Uuid
  status            String   @default("pending") // pending | approved | rejected | cancelled
  currentStepOrder  Int      @default(1) @map("current_step_order")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at")

  company         Company           @relation(fields: [companyId], references: [id])
  workflow        ApprovalWorkflow  @relation(fields: [workflowId], references: [id])
  requestedByUser User              @relation("ApprovalRequestedBy", fields: [requestedBy], references: [id])
  actions         ApprovalAction[]

  @@map("approval_requests")
}

model ApprovalAction {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestId  String   @map("request_id") @db.Uuid
  stepOrder  Int      @map("step_order")
  actorId    String   @map("actor_id") @db.Uuid
  decision   String   // approved | rejected
  comments   String?
  actionedAt DateTime @default(now()) @map("actioned_at")

  request ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actor   User            @relation("ApprovalActionedBy", fields: [actorId], references: [id])

  @@map("approval_actions")
}

// ============================================================
// Multi-Warehouse Inventory — see migration 094 for the full
// design rationale (cached stock quantity updated atomically
// alongside the movement ledger, transfer pairing, never-negative
// enforcement in the application layer).
// ============================================================

model Warehouse {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId  String    @map("company_id") @db.Uuid
  name       String    @db.VarChar(150)
  address    String?
  isActive   Boolean   @default(true) @map("is_active")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at")

  company   Company          @relation(fields: [companyId], references: [id])
  stock     InventoryStock[]
  movements StockMovement[]
  invoices  Invoice[]

  @@unique([companyId, name])
  @@map("warehouses")
}

// Named StockItem (not InventoryItem) — this system ALREADY has a
// different, accounting-integrated InventoryItem model (single
// implicit warehouse, average costing, linked to inventory/COGS GL
// accounts — see finance module). This is a deliberately separate,
// simpler multi-warehouse stock-tracking model with no accounting
// integration; the two are NOT the same catalog and are not
// currently linked to each other.
model StockItem {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId      String    @map("company_id") @db.Uuid
  sku            String    @db.VarChar(100)
  name           String    @db.VarChar(200)
  description    String?
  unitOfMeasure  String    @default("unit") @map("unit_of_measure") @db.VarChar(50)
  reorderPoint   Decimal?  @map("reorder_point") @db.Decimal(14, 2)
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  company   Company          @relation(fields: [companyId], references: [id])
  stock     InventoryStock[]
  movements StockMovement[]
  purchaseOrderItems PurchaseOrderItem[]
  invoiceItems InvoiceItem[]
  quotationItems QuotationItem[]

  @@unique([companyId, sku])
  @@map("stock_items")
}

model InventoryStock {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId       String   @map("company_id") @db.Uuid
  warehouseId     String   @map("warehouse_id") @db.Uuid
  itemId          String   @map("item_id") @db.Uuid
  quantityOnHand  Decimal  @default(0) @map("quantity_on_hand") @db.Decimal(14, 2)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  company   Company   @relation(fields: [companyId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  item      StockItem @relation(fields: [itemId], references: [id])

  @@unique([warehouseId, itemId])
  @@map("inventory_stock")
}

model StockMovement {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId          String   @map("company_id") @db.Uuid
  itemId             String   @map("item_id") @db.Uuid
  warehouseId        String   @map("warehouse_id") @db.Uuid
  movementType       String   @map("movement_type") // receipt | issue | transfer_out | transfer_in | adjustment
  quantity           Decimal  @db.Decimal(14, 2)
  relatedMovementId  String?  @map("related_movement_id") @db.Uuid
  reason             String?
  performedBy        String   @map("performed_by") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at")

  company        Company        @relation(fields: [companyId], references: [id])
  item           StockItem      @relation(fields: [itemId], references: [id])
  warehouse      Warehouse      @relation(fields: [warehouseId], references: [id])
  performedByUser User          @relation(fields: [performedBy], references: [id])
  relatedMovement StockMovement? @relation("MovementPair", fields: [relatedMovementId], references: [id])
  pairedMovements StockMovement[] @relation("MovementPair")

  @@map("stock_movements")
}

// ============================================================
// ZATCA Phase 2 (Integration Phase) — see migration 099 for the
// full design rationale and the IMPORTANT disclosure about this
// never having been verified against a live ZATCA environment.
// ============================================================

model ZatcaCertificate {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId             String    @map("company_id") @db.Uuid
  csidType              String    @map("csid_type") // compliance | production
  privateKeyEncrypted   String    @map("private_key_encrypted")
  csrPem                String?   @map("csr_pem")
  certificatePem        String?   @map("certificate_pem")
  binarySecurityToken   String?   @map("binary_security_token")
  apiSecretEncrypted    String?   @map("api_secret_encrypted")
  status                String    @default("pending_csr") // pending_csr | pending_zatca_issuance | active | expired | revoked
  zatcaRequestId        String?   @map("zatca_request_id")
  issuedAt              DateTime? @map("issued_at")
  expiresAt             DateTime? @map("expires_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at")

  company     Company           @relation(fields: [companyId], references: [id])
  submissions ZatcaSubmission[]

  @@map("zatca_certificates")
}

model ZatcaSubmission {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId             String    @map("company_id") @db.Uuid
  invoiceId             String    @map("invoice_id") @db.Uuid
  certificateId         String    @map("certificate_id") @db.Uuid
  submissionType        String    @map("submission_type") // clearance | reporting
  zatcaInvoiceUuid       String    @map("zatca_invoice_uuid")
  invoiceHash           String    @map("invoice_hash")
  previousInvoiceHash   String    @map("previous_invoice_hash")
  status                String    @default("pending") // pending | cleared | reported | rejected | failed
  requestXml            String?   @map("request_xml")
  responseBody          String?   @map("response_body")
  zatcaWarnings         String?   @map("zatca_warnings")
  clearedInvoiceXml     String?   @map("cleared_invoice_xml")
  qrCodeBase64          String?   @map("qr_code_base64")
  submittedAt           DateTime? @map("submitted_at")
  createdAt             DateTime  @default(now()) @map("created_at")

  company     Company          @relation(fields: [companyId], references: [id])
  invoice     Invoice          @relation(fields: [invoiceId], references: [id])
  certificate ZatcaCertificate @relation(fields: [certificateId], references: [id])

  @@map("zatca_submissions")
}
