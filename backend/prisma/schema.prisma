// ============================================================
// Finance — Phase F14/F15 (Inventory Foundation + Invoice/Bill
// Integration). Weighted Average Cost. See migration 043 for the
// full rationale on why opening stock posts no journal entry and
// why every manual adjustment requires an explicit offset account.
// ============================================================

model InventoryItem {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId          String    @map("company_id") @db.Uuid
  sku                String    @db.VarChar(50)
