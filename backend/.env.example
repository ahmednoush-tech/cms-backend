# PostgreSQL connection (used by Prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/cms_db?schema=public"

# JWT
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_TTL="7d"

# Platform Admin — Mizan's own ops team, completely separate
# secret from the tenant JWTs above (see rls-bypass.util.ts and
# platform-admin-jwt.strategy.ts for why this MUST stay a
# different value: a token signed with JWT_ACCESS_SECRET must
# never be valid here, and vice versa). Longer default TTL (8h)
# than a tenant session (15m) since this is a small internal team
# using it for a full workday, not a public-facing session.
PLATFORM_ADMIN_JWT_SECRET="change-me-platform-admin-secret"
PLATFORM_ADMIN_JWT_TTL="8h"

# App
PORT=3000
NODE_ENV=development

# Account lockout policy
MAX_FAILED_LOGIN_ATTEMPTS=5

# Password reset emails — used to build the link inside the email
FRONTEND_URL="http://localhost:5173"

# SMTP (optional — if SMTP_HOST is left unset, password-reset
# emails are logged to the server console instead of sent, so the
# app still runs correctly before this is configured)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="no-reply@example.com"

# Outlook email integration (optional) — each user connects their
# OWN Outlook account to log matching emails as CRM interactions.
# The Client ID/Secret are now PER-COMPANY, entered by an admin
# from Company Settings → Microsoft Integration (never here) — see
# migration 074. Only the redirect URI below stays a
# deployment-wide setting, since it's this backend's own callback
# path, not something that varies by company.
MICROSOFT_REDIRECT_URI="http://localhost:3000/api/v1/email-integration/callback"

# REQUIRED once any company saves a Microsoft Client Secret — the
# master key used to encrypt/decrypt those secrets at rest (AES-
# 256-GCM). Generate a long random value once per deployment and
# never change it afterward (changing it makes every already-saved
# secret permanently undecryptable). Example generation:
# `openssl rand -hex 32`
CREDENTIALS_ENCRYPTION_KEY=""

# File storage backend for attachments. "local" (default, or leave
# unset) stores files on this server's own disk — fine for local
# development or a genuinely single-instance deployment, but does
# NOT work correctly behind a load balancer with more than one app
# instance, and has no built-in redundancy. Set to "s3" for
# production or any multi-instance deployment.
STORAGE_DRIVER="local"

# Required only when STORAGE_DRIVER=s3. Works with real AWS S3 or
# any S3-compatible service (MinIO, DigitalOcean Spaces, Cloudflare
# R2, etc.) — for a non-AWS provider, also set S3_ENDPOINT (and
# S3_FORCE_PATH_STYLE=true if that provider requires path-style
# addressing, e.g. MinIO).
#
# IMPORTANT: the bucket itself must have CORS configured to allow
# GET requests from this app's frontend origin(s), or downloads
# will fail with a browser CORS error even with everything below
# set correctly. See s3-storage.provider.ts's file comment.
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""
S3_FORCE_PATH_STYLE="false"
